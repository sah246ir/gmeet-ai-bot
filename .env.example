# Copy this file to .env and fill in the values below before running
# `docker compose up`.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gmeet_bot
POSTGRES_PORT=5433

# --- Redis ---
REDIS_PORT=6380

# --- gmeet-bot ---
# Where a joinee container should stream audio back to. Joinee containers
# are created directly against the Docker daemon (not this compose
# network), so "localhost" only works if joinee ends up reachable at the
# host's localhost (e.g. gmeet-bot itself running outside Docker, or the
# host exposing gmeet-bot's port back to itself). Adjust for your setup.
CONSUMER_URL=http://localhost:3000
DOCKER_VERSION=1.46
USE_DOCKER=1
DOCKER_IMAGE=meet-joiner:latest

# Required third-party API keys — gmeet-bot will not start without these.
DEEPGRAM_KEY=
PINECONE_KEY=
PINECONE_INDEX=
GROQ_KEY=

# --- dashboard ---
# Must be reachable from the browser, not from inside the dashboard
# container — localhost:3000 works because gmeet-bot's port is published
# to the host below.
VITE_API_URL=http://localhost:3000
