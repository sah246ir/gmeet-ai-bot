generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}
enum JobType {
  PROCESS_TRANSCRIPT
  GENERATE_EMBEDDINGS
  INDEX_PINECONE
  GENERATE_SUMMARY
  EXTRACT_ACTION_ITEMS
}
enum MeetingStatus {
  STARTING
  CREATING_JOINEE_BOT
  JOINING_MEETING
  MEETING_PROCESSED
  PROCESSING_MEETING
  COMPLETED
  FAILED
}

model Meeting {
  id        String    @id @default(cuid())
  url       String
  containerId       String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  jobs      Job[]
  transcriptSegments      TranscriptSegment[]
  statusLogs MeetingStatusLog[]

  sessionToken String
  session      Session  @relation(fields: [sessionToken], references: [token])

  @@index([sessionToken])
}

model MeetingStatusLog {
  id        String        @id @default(cuid())

  meetingId String
  meeting   Meeting       @relation(fields: [meetingId], references: [id])

  status    MeetingStatus
  error     String?

  createdAt DateTime      @default(now())

  @@index([meetingId, createdAt])
}

model TranscriptSegment {
  id        String   @id @default(cuid())

  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id])

  text      String

  startTime Float
  endTime   Float

  speakerId String?
  words     Json?

  createdAt DateTime @default(now())

  @@index([meetingId, startTime])
}

model Session {
  token     String   @id
  createdAt DateTime @default(now())
  expiresAt DateTime
  meetings  Meeting[]
}

model Job {
  id        String    @id @default(cuid())
  meetingId String
  meeting   Meeting   @relation(fields: [meetingId], references: [id])

  type      JobType
  status    JobStatus @default(PENDING)
  error     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([meetingId, type])
}