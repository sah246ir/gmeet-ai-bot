generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MeetingEvent {
  STARTING
  CREATING_JOINEE_BOT
  JOINING_MEETING
  WAITING_FOR_ENTRY
  MEETING_PROCESSED
  PROCESS_TRANSCRIPT
  GENERATE_EMBEDDINGS
  INDEX_PINECONE
  GENERATE_SUMMARY
  EXTRACT_ACTION_ITEMS
  COMPLETED
  FAILED
}

enum MeetingLogStatus {
  PENDING
  FAILED
  SUCCESS
}

enum MeetingState {
  PENDING
  DONE
  FAILED
}

model Meeting {
  id        String    @id @default(cuid())
  url       String
  containerId       String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  transcriptSegments      TranscriptSegment[]
  statusLogs MeetingStatusLog[]
  insight   MeetingInsight?

  state       MeetingState @default(PENDING)
  completedAt DateTime?

  sessionToken String
  session      Session  @relation(fields: [sessionToken], references: [token])

  @@index([sessionToken])
}

model MeetingInsight {
  id        String   @id @default(cuid())

  meetingId String   @unique
  meeting   Meeting  @relation(fields: [meetingId], references: [id])

  overview     String
  keyPoints    Json
  decisions    Json
  actionItems  Json

  speakerCount Int
  speakers     Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MeetingStatusLog {
  id           String           @id @default(cuid())

  meetingId    String
  meeting      Meeting          @relation(fields: [meetingId], references: [id])

  event        MeetingEvent
  status       MeetingLogStatus @default(SUCCESS)
  error        String?

  createdAt    DateTime         @default(now())
  closingState DateTime?

  @@index([meetingId, createdAt])
  @@index([meetingId, event, createdAt])
}

model TranscriptSegment {
  id        String   @id @default(cuid())

  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id])

  text      String

  startTime Float
  endTime   Float

  speakerId String?
  words     Json?

  createdAt DateTime @default(now())

  @@index([meetingId, startTime])
}

model Session {
  token     String   @id
  createdAt DateTime @default(now())
  expiresAt DateTime
  meetings  Meeting[]
}
