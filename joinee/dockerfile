FROM node:20-bookworm AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

RUN npm run build


FROM node:20-bookworm AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV DISPLAY=:99

# System dependencies
RUN apt-get update && apt-get install -y \
    pulseaudio \
    pulseaudio-utils \
    ffmpeg \
    xvfb \
    dbus \
    dbus-x11 \
    alsa-utils \
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    && rm -rf /var/lib/apt/lists/*


# Production dependencies
COPY package*.json ./
RUN npm ci --omit=dev


# Install Playwright Chrome
RUN npx playwright install chrome


# Application
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/google_session.json ./
COPY start.sh ./start.sh

RUN chmod +x start.sh


EXPOSE 3000

CMD ["./start.sh"]